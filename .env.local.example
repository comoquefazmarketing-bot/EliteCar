# Supabase — copie para .env.local e configure na Vercel (Project Settings > Environment Variables)

# URL do projeto (pode ser pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role — USADA APENAS NA SERVER ACTION (server-side).
# NUNCA exponha com prefixo NEXT_PUBLIC_ e nunca commite a chave real.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui
